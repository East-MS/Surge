#!name=番茄去广告
#!desc=去除开屏、章末和翻页插屏
#!author = anpplex
#!system=ios
#!category=App优化增强
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/fanqie.png
#!date=2026-10-23

[Rule]
DOMAIN,zlink.ugsdk.cn,REJECT,extended-matching,pre-matching
DOMAIN,praisewindow.ugsdk.cn,REJECT,extended-matching,pre-matching
DOMAIN,content-open.douyin.com,REJECT,extended-matching,pre-matching
DOMAIN,webcast-open.douyin.com,REJECT,extended-matching,pre-matching
DOMAIN,lf-webcast-gr-sourcecdn.bytegecko.com,REJECT,extended-matching,pre-matching
DOMAIN,lf3-reading.fqnovelstatic.com,REJECT,extended-matching,pre-matching
DOMAIN,mon11-misc.fqnovel.com,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,-applog.fqnovel.com,REJECT,extended-matching,pre-matching

DOMAIN-KEYWORD,pangolin-sdk-toutiao,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangle.io,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,reading-ad.qznovelvod.com,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,-ad-sign.byteimg.com,REJECT,extended-matching,pre-matching
AND,((DOMAIN-SUFFIX,zijieapi.com),(DOMAIN-KEYWORD,ads)),REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ad.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,i.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,i-lq.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,ib-lq.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,activity-ag.awemeughun.com,REJECT,extended-matching,pre-matching
DOMAIN,dig.bdurl.net,REJECT,extended-matching,pre-matching
DOMAIN,dig.zjurl.cn,REJECT,extended-matching,pre-matching

[URL Rewrite]
^https?:\/\/.+\.pstatp\.com\/(obj|img)\/ad - reject
^https?:\/\/.+\.pstatp\.com\/(obj|img)\/web\.business\.image\/.+ - reject
^https?:\/\/gurd\.snssdk\.com\/src\/server\/v\d\/package - reject
^https?:\/\/.+\.byteimg.com/tos-cn-i-1yzifmftcy\/(.+)-jpeg\.jpeg - reject
^https?:\/\/.+\.pstatp\.com\/obj\/mosaic-legacy\/.+\?from\=ad - reject
^https?:\/\/.+\.pstatp\.com\/bytecom\/resource\/track_log\/src\/.+ - reject
^https?:\/\/.+\.snssdk\.com\/video\/play\/1\/toutiao\/.+\/mp4 - reject
^https?:\/\/.+\.snssdk.com\/api\/ad\/.+ - reject
^https?:\/\/.+\.byteimg\.com\/ad-app-package - reject
^https?:\/\/.+\.byteimg\.com\/web\.business\.image - reject
^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad - reject
^https?:\/\/tnc3-alisc1\.zijieapi\.com\/get_domains - reject
^https?:\/\/.+\.pangolin-sdk-toutiao\d?(?:-b)?\.com\/api\/ad\/ - reject
^https?:\/\/.+\.pglstatp-toutiao\.com\/obj\/ad-pattern\/ - reject
^https?:\/\/v\d[0-9a-z-]*reading-ad\.qznovelvod\.com\/ - reject

[Rule]
# 番茄小说 version = 3.1
DOMAIN,p6-ad-sign.byteimg.com,REJECT
DOMAIN,p9-ad-sign.byteimg.com,REJECT
# DOMAIN-SUFFIX,byteimg.com,DIRECT
DOMAIN,i.snssdk.com,REJECT
DOMAIN,i-lq.snssdk.com,REJECT
DOMAIN,dig.bdurl.net,REJECT
DOMAIN,imapi3-normal-lf.zijieapi.com,DIRECT
DOMAIN-KEYWORD,zijieapi,REJECT
# DOMAIN,ads3-normal-lq.zijieapi.com,REJECT
# DOMAIN,ads5-normal-lq.zijieapi.com,REJECT
# DOMAIN,polaris3-normal-lq.zijieapi.com,REJECT
DOMAIN,activity-ag.awemeughun.com,REJECT

DOMAIN,mcs.snssdk.com,REJECT
DOMAIN,tnc3-alisc1.snssdk.com,REJECT
DOMAIN,security-lq.snssdk.com,REJECT
DOMAIN,tnc3-aliec2.snssdk.com,REJECT
DOMAIN,is.snssdk.com,REJECT

DOMAIN,msync-im1-vip6-std.easemob.com,REJECT

DOMAIN,apd-pcdnwxlogin.teg.tencent-cloud.net,REJECT
DOMAIN,api.iegadp.qq.com,REJECT

DOMAIN,sf3-ttcdn-tos.pstatp.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
# DOMAIN,p3-be-pack-sign.pglstatp-toutiao.com,REJECT
# DOMAIN,sf3-be-pack.pglstatp-toutiao.com,REJECT

DOMAIN,*default.ixigua.com,REJECT
DOMAIN,v6-novelapp.ixigua.com,REJECT
DOMAIN,*novelapp.ixigua.com,REJECT
# DOMAIN,v3-default.ixigua.com,REJECT
# DOMAIN,v9-default.ixigua.com,REJECT
# DOMAIN,v6-default.ixigua.com,REJECT

DOMAIN-SUFFIX,byteorge.com,REJECT
DOMAIN-SUFFIX,bytegoofy.com,REJECT
DOMAIN-SUFFIX,bytedance.com,REJECT

IP-CIDR,49.71.37.101/32,REJECT,no-resolve
IP-CIDR,117.71.105.23/32,REJECT,no-resolve
IP-CIDR,218.94.207.205/32,REJECT,no-resolve
IP-CIDR,117.92.229.188/32,REJECT,no-resolve
IP-CIDR,101.36.166.16/32,REJECT,no-resolve
IP-CIDR,180.96.2.114/32,REJECT,no-resolve

URL-REGEX,*-default.ixigua.com,REJECT
# URL-REGEX,.+web\.business\.image,REJECT
URL-REGEX,^http:\/\/.+\.byteimg\.com\/ad-app-package,REJECT
URL-REGEX,^http:\/\/.+\.byteimg\.com\/web\.business\.image,REJECT
# 番茄视频广告页的sdk agent都是ttplayer
# USER-AGENT,ttplayer*,REJECT

[URL Rewrite]
# 番茄小说去章末广告
^https?:\/\/.+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/(get_ads|stats|settings)\/ - reject
^https?:\/\/.+\.pglstatp-toutiao\.com\/.+\/toutiao\.mp4 - reject
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/(ad-app-package|ad)\/.+ - reject
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/web\.business\.image\/.+ - reject
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/obj\/ad-pattern\/renderer - reject
^https?:\/\/gurd\.snssdk\.com\/src\/server\/v3\/package - reject
^https?:\/\/.+\.byteimg.com/tos-cn-i-1yzifmftcy\/(.+)-jpeg\.jpeg - reject
^https?:\/\/.+\.pstatp\.com\/obj\/mosaic-legacy\/.+\?from\=ad - reject
^https?:\/\/.+\.pstatp\.com\/bytecom\/resource\/track_log\/src\/.+ - reject
^https?:\/\/.+\.snssdk\.com\/video\/play\/1\/toutiao\/.+\/mp4 - reject
^https?:\/\/.+\.snssdk.com\/api\/ad\/.+ - reject
# 下面两条来自他人,暂不知是哪个app
^https?:\/\/.+?\.snssdk\.com\/motor\/operation\/activity\/display\/config\/V2\/ - reject

^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(ad-app-package|ad)\/.+ - reject
^https?:\/\/adim\.pinduoduo\.com\/.+\/toutiao\?.+ - reject
^https?:\/\/v(\d)+-novelapp\.fqnovelvod\.com\/.+\/video\/.+ - reject

[MITM]
hostname = %APPEND% *.pangolin-sdk-toutiao,*.pangolin-sdk-toutiao.*,*.pstatp.com,*.pstatp.com.*,*.pglstatp-toutiao.com.*,*.pglstatp-toutiao.com,gurd.snssdk.com,gurd.snssdk.com.*,*default.ixigua.com,adim.pinduoduo.com,*.fqnovelvod.com


[MITM]
hostname = %APPEND% *.pangolin-sdk-toutiao.*, *.pangolin-sdk-toutiao-b.com, *.pstatp.com, *.pglstatp-toutiao.com, gurd.snssdk.com, *default.ixigua.com, lf-cdn-tos.bytescm.com, tnc3-alisc1.zijieapi.com, *reading-ad.qznovelvod.com

#!name=彩云天气去广告
#!desc=屏蔽广告域名、推广入口及活动内容
#!system=ios
#!category=App优化增强

[Rule]
DOMAIN,abyss.cyapi.cn,REJECT
DOMAIN,ad.cyapi.cn,REJECT
DOMAIN,gather.colorfulclouds.net,REJECT

[Map Local]
# 推广入口、试用卡及产品推广
(?i)^https://biz\.cyapi\.cn/(p/v1/entries|p/v1/trial_card/info|v2/product) data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"

# 页面推广配置、消息中心及首页运营入口
(?i)^https://starplucker\.cyapi\.cn/v3/(config/cypage/\w+/conditions|notification/message_center|operation/homefeatures) data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"

[Script]
Caiyun-AdBlock = type=http-response,pattern=(?i)^https://(wrapper\.cyapi\.cn|api\.caiyunapp\.com)/v1/activity/?(\?|$),requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/East-MS/Surge/refs/heads/master/scripts/Caiyun-AdBlock.js

[MITM]
hostname = %APPEND% biz.cyapi.cn, starplucker.cyapi.cn, api.caiyunapp.com, cdn-w.caiyunapp.com, wrapper.cyapi.cn
